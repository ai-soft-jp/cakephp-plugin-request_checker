{
    "name": "ai-soft-jp/cake-request-checker",
    "description": "RequestChecker",
    "keywords": ["cakephp"],
    "type": "cakephp-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1.0",
        "ext-mbstring": "*",
        "cakephp/chronos": "^3.0",
        "laminas/laminas-diactoros": "^3.0"
    },
    "require-dev": {
        "cakephp/event": "^5.0",
        "cakephp/i18n": "^5.0",
        "cakephp/cakephp-codesniffer": "*",
        "phake/phake": "*",
        "phpunit/phpunit": "^10.0",
        "psr/http-server-middleware": "*"
    },
    "autoload": {
        "psr-4": {
            "RequestChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RequestChecker\\Test\\": "tests"
        }
    },
    "scripts": {
        "check": ["@cs-check", "@test"],
        "test": "phpunit",
        "cs-check": "phpcs --colors -p src/ tests/",
        "cs-fix": "phpcbf --colors -p src/ tests/"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
